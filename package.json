{
  "name": "grocery",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "FreshMart - pipeline: Unit Testing → API Testing → UI/Regression Testing → Quality Gate → Results/Reports",
  "scripts": {
    "test:unit:server": "npm --prefix server run test:unit",
    "test:unit:client": "npm --prefix client run test:unit",
    "test:unit": "npm run test:unit:server && npm run test:unit:client",
    "test:api": "npm --prefix server run test:api",
    "test:ui": "npm --prefix client run test:ui",
    "quality-gate": "node quality-gate.js",
    "test:report": "node test-report.js",
    "test": "npm run quality-gate"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1"
  }
}
