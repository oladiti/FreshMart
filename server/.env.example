# FreshMart Server Configuration
# Copy this file to .env and fill in your own values.

# Port the Express server listens on
PORT=5000

# MongoDB connection string (Atlas or local)
MONGO_URI=mongodb://127.0.0.1:27017/grocery

# Secret used to sign JWT tokens. Must be a strong, unique value of at least 32
# characters -- the server refuses to start otherwise, because a weak secret
# lets anyone forge tokens and impersonate any user (including admins).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string

# How long issued access tokens stay valid (jsonwebtoken "expiresIn" syntax,
# e.g. 15m, 12h). Access tokens are delivered as short-lived HttpOnly cookies.
# Keep this short: the refresh token (below) transparently renews the session.
ACCESS_TOKEN_TTL=15m

# How long a refresh token stays valid. Refresh tokens rotate on every use and
# are revoked if a rotated (already-used) token is replayed. Also the lifetime
# of the session cookie, so it controls how long a user stays logged in.
REFRESH_TOKEN_TTL=7d

# (Deprecated) Legacy alias for ACCESS_TOKEN_TTL. Prefer ACCESS_TOKEN_TTL.
JWT_EXPIRES_IN=15m

# Public URL of the storefront, used to build the account-verification and
# password-reset links we email out. Set this to your real frontend origin so
# links never depend on the request's (spoofable) Host header.
# Defaults to http://localhost:5173 when unset.
CLIENT_URL=http://localhost:5173

# Node environment
# NODE_ENV=production
NODE_ENV=development

# Auth cookies are automatically marked Secure when NODE_ENV=production and
# use SameSite=Lax. This only affects the token cookies set on login/refresh.

# Use the stronger `__Host-` cookie prefix (e.g. __Host-fm_at) whenever the
# request is served over HTTPS. Requires Secure + Path=/ and forbids a Domain,
# so enable only for single-origin deploys. Leave unset/0 in dev and tests.
COOKIE_HOST_PREFIX=0

# Screen new/changed passwords against HaveIBeenPwned (k-anonymity). Fails open
# if the API is unreachable. Set to 0 to disable; disabled in tests regardless.
BREACH_CHECK_ENABLED=1

# Require accounts with role=admin to have TOTP 2FA enabled. Admins without it
# receive a limited setup token at login instead of a full session.
REQUIRE_ADMIN_2FA=1

# Require a verified email before checkout/orders. Defaults to enabled in
# production and disabled in development/tests (so local work isn't blocked when
# SMTP is unset). Set to 1 to force it on or 0 to disable even in production.


# Comma-separated list of browser origins allowed to call the API (CORS).
# Leave unset to allow the local dev/preview ports only. In a same-origin
# deploy (frontend served by this server) CORS is not needed for the storefront.
# Example: CORS_ORIGIN=https://freshmart.example.com,https://www.freshmart.example.com
CORS_ORIGIN=

# Stripe payment keys (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx

# Transactional email (verification, reset links, order confirmation).
#
# Default provider: the Gmail API. It sends over HTTPS/443, which avoids hosts
# (e.g. Render's free tier) that block outbound SMTP on ports 25/465/587, and it
# needs no verified domain -- only an OAuth refresh token for a Gmail account.
#
# Setup: create an OAuth client (Desktop app) in Google Cloud, enable the Gmail
# API, add the https://www.googleapis.com/auth/gmail.send scope, publish the app,
# then mint a refresh token via https://developers.google.com/oauthplayground.
# GMAIL_SENDER must be the Gmail address that authorized the token.
EMAIL_PROVIDER=gmail_api
GMAIL_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GMAIL_REFRESH_TOKEN=your-refresh-token
GMAIL_SENDER=you@gmail.com
GMAIL_CLIENT_SECRET=your-gmail-client-secret
# EMAIL_FROM overrides the display From header; it must match GMAIL_SENDER (or a
# verified alias on that account).
EMAIL_FROM=FreshMart <you@gmail.com>
EMAIL_TIMEOUT_MS=10000

# Alternative: Resend (HTTPS API). Requires a verified sending domain.
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# EMAIL_FROM=FreshMart <no-reply@yourdomain.com>

# Alternative: legacy SMTP. Blocked on Render's free tier (ports 25/465/587),
# but useful on hosts that allow it.
# EMAIL_PROVIDER=smtp
# EMAIL_USER=your_smtp_user
# EMAIL_PASS=your_smtp_password
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587

# Seeded admin account, created by "npm run seed".
# Only used when the account does not already exist. Change these before seeding
# any database you do not fully control -- the defaults below are public.
ADMIN_EMAIL=admin@freshmart.com
ADMIN_PASSWORD=admin12345
ADMIN_NAME=Admin

# AI shopping assistant (POST /api/ai/chat).
# Any OpenAI-compatible /chat/completions provider works. When AI_API_KEY is
# unset the endpoint transparently falls back to the rule-based assistant at
# /api/assistant/query, so the store keeps working with no AI configured.
#
# Defaults point at Google Gemini's OpenAI-compatible endpoint. The free tier is
# generous enough for testing:
#   1. Create a key at https://aistudio.google.com/apikey
#   2. Paste it into AI_APIKEY below (server/.env, NOT this example file)
#   3. Restart the server
# For production, switch to a pro variant (e.g. gemini-3.8-pro) or enable
# billing for a higher quota. Verify the exact model id in AI Studio.
#
# Alternative pay-as-you-go option: OpenCode Zen (https://opencode.ai/auth) with
#   AI_BASE_URL=https://opencode.ai/zen/v1 and a model like deepseek-v4-flash.
AI_API_KEY=your-ai-api-key
AI_MODEL=gemini-3.8-flash
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MAX_TOKENS=700
AI_TIMEOUT_MS=10000
AI_RATE_LIMIT_PER_MIN=30