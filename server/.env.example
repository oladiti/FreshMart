# FreshMart Server Configuration
# Copy this file to .env and fill in your own values.

# Port the Express server listens on
PORT=5000

# MongoDB connection string (Atlas or local)
MONGO_URI=mongodb://127.0.0.1:27017/grocery

# Secret used to sign JWT tokens (use a long random string)
JWT_SECRET=change_me_to_a_long_random_string

# Node environment
NODE_ENV=production

# Stripe payment keys (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx

# Nodemailer credentials for transactional email (reset links, order confirmation)
# With SMTP unset, reset links are returned in the API response for development.
EMAIL_USER=your_smtp_user
EMAIL_PASS=your_smtp_password

# Seeded admin account, created by "npm run seed".
# Only used when the account does not already exist. Change these before seeding
# any database you do not fully control -- the defaults below are public.
ADMIN_EMAIL=admin@freshmart.com
ADMIN_PASSWORD=admin12345
ADMIN_NAME=Admin

# AI shopping assistant (POST /api/ai/chat).
# Any OpenAI-compatible /chat/completions provider works. When AI_API_KEY is
# unset the endpoint transparently falls back to the rule-based assistant at
# /api/assistant/query, so the store keeps working with no AI configured.
#
# Defaults point at Google Gemini's OpenAI-compatible endpoint. The free tier is
# generous enough for testing:
#   1. Create a key at https://aistudio.google.com/apikey
#   2. Paste it into AI_APIKEY below (server/.env, NOT this example file)
#   3. Restart the server
# For production, switch to a pro variant (e.g. gemini-3.8-pro) or enable
# billing for a higher quota. Verify the exact model id in AI Studio.
#
# Alternative pay-as-you-go option: OpenCode Zen (https://opencode.ai/auth) with
#   AI_BASE_URL=https://opencode.ai/zen/v1 and a model like deepseek-v4-flash.
AI_API_KEY=
AI_MODEL=gemini-3.8-flash
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MAX_TOKENS=700
AI_TIMEOUT_MS=10000
AI_RATE_LIMIT_PER_MIN=30