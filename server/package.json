{
  "name": "grocery-server",
  "version": "1.0.0",
  "main": "server.js",
  "type": "module",
  "author": "Oladiti Abiodun",
  "scripts": {
    "start": "node server.js",
    "seed": "node seeder.js",
    "migrate:slugs": "node migrate-slugs.js",
    "migrate:order-categories": "node migrate-order-categories.js",
    "seed:e2e": "node e2e-seed.js",
    "seed:reset": "node seeder.js --reset",
    "destroy": "node seeder.js -d",
    "dev": "nodemon server.js",
    "test:unit": "jest __tests__/unit",
    "test:api": "jest __tests__/api --runInBand --forceExit",
    "test:regression": "jest __tests__/regression --runInBand --forceExit",
    "test:all": "jest --runInBand --forceExit --coverage",
    "test": "jest --runInBand --forceExit"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.0",
    "mongodb": "^6.20.0",
    "mongoose": "^8.18.2",
    "mongoose-autopopulate": "^1.1.0",
    "nodemailer": "^10.1.0",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.4",
    "resend": "^6.32.1",
    "stripe": "^23.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "babel-jest": "^30.5.1",
    "jest": "^30.5.1",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^2.0.22",
    "supertest": "^7.2.2"
  }
}
