# Dependencies
node_modules/

# Build output
client/dist/
coverage/
reports/
playwright-report/
test-results/

# Env / secrets
# Ignore every env variant, but keep the sanitized templates tracked.
.env
.env.*
!.env.example
*.secret
*.token
*.local

# Credential / token artifacts (scratch output from manual API probing).
# These have previously captured live JWTs -- keep them out of history.
server/login-*.txt
server/*-token.txt
server/*-secrets.txt

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Runtime version pin (hosting-provided, not tracked)
.node-version